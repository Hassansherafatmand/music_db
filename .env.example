# The website's private settings.
# Copy this file to .env and fill it in:   cp .env.example .env
# .env is in .gitignore, so your passwords never go to GitHub.

# Where MySQL is, and the database user the website logs in as.
# (README.md shows how to make the music_app user.)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=music_app
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=music_db

# A long random text that signs the login cookie. Make your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-text-here

# The password for the admin page (/admin). Leave it empty to turn the admin page off.
ADMIN_PASSWORD=choose-an-admin-password
